# Contoh /etc/toa-staging.env DI VPS (bukan berkas nyata -- TIDAK ADA kredensial di sini).
# Nilai sungguhan dibuat LANGSUNG di VPS saat bootstrap (SECRET_KEY & password DB via
# `openssl rand -hex`/`secrets.token_hex`), tidak pernah disalin dari sini, tidak pernah
# di-commit. Lihat docs/runbook-staging-2026-09-04.md bagian "Cara memasang" untuk perintah
# persis yang dipakai.
DEBUG=False
SECRET_KEY=__GANTI_DI_VPS_openssl_rand_hex_32__
DATABASE_URL=postgres://toa_staging:__GANTI_DI_VPS__@127.0.0.1:5432/toa_staging
PORT=8001
ALLOWED_HOSTS=truthofauditor.taila54dc6.ts.net,truthofauditor,100.102.118.125,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://truthofauditor.taila54dc6.ts.net
GEO_BLOCK_ENABLED=false
SECURE_HSTS_SECONDS=0
MEDIA_ROOT=/var/lib/toa-staging/media
PYTHONUNBUFFERED=1
